# Copy to .env: `cp .env.example .env`. Used by docker-compose.yml.

# Postgres, for the `db` service. Change it before running anything real.
POSTGRES_PASSWORD=change-me

# The heartbeat token for examples/quickstart.yml. Any string of 16+ characters;
# change it if you keep the quickstart config around.
QUICKSTART_PING_TOKEN=quickstart-ping-token-please-change

# Optional: SMTP URL for email alerts (smtp://user:pass@host:587). Leave unset
# to disable them — a config with `alerts.email` set requires this.
# SMTP_URL=

# Optional: how long the worker keeps run history before pruning it.
# GREENLIE_RETENTION=30d
